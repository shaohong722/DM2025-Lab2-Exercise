  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Concat\n",
    "#Identifying Train and Test id\n",
    "Train_id = Data_Identification[Data_Identification['split']=='train']\n",
    "Test_id = Data_Identification[Data_Identification['split']=='test']\n",
    "\n",
    "#Splitting dataframe\n",
    "Train_df = Posts[Posts['post_id'].isin(Train_id['id'])] # Train_id\n",
    "Test_df = Posts[Posts['post_id'].isin(Test_id['id'])] #Test_id"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "Train_df = pd.merge(left=Train_df,right=Emotion,left_on='post_id',right_on='id',how='left')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "## Duplicate some class with fewer data\n",
    "\n",
    "sample = 4000\n",
    "\n",
    "Small_df = Train_df[(Train_df['emotion'] != 'joy')&(Train_df['emotion'] != 'anger')]\n",
    "Train_df = pd.concat([Train_df,Small_df.sample(n=sample)])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "X_train.shape:  (51890, 768)\n",
      "y_train.shape:  (51890,)\n",
      "X_test.shape:  (16281, 768)\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "X_train = np.vstack(Train_df['sentence_embedding'])\n",
    "X_test = np.vstack(Test_df['sentence_embedding'])\n",
    "Y_train = Train_df['emotion']\n",
    "\n",
    "print('X_train.shape: ', X_train.shape)\n",
    "print('y_train.shape: ', Y_train.shape)\n",
    "print('X_test.shape: ', X_test.shape)"
   ]
  },
