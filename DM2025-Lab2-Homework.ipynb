    "import pandas as pd\n",
    "\n",
    "Posts = pd.read_pickle('.\\data\\kraggle\\Posts_distilbert_embedding.pkl')\n",
    "Data_Identification = pd.read_csv(r'.\\data\\kraggle\\data_identification.csv')\n",
