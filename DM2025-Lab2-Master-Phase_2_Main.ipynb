   "source": [
    "# Answer here\n",
    "import pandas as pd\n",
    "\n",
    "Ex7_0_shots = pd.read_csv('./results/llm_classification_results/results_samples_20_shots_0.csv')\n",
    "Ex7_1_shots = pd.read_csv('./results/llm_classification_results/results_samples_20_shots_1.csv')\n",
    "Ex7_5_shots = pd.read_csv('./results/llm_classification_results/results_samples_20_shots_5.csv')\n",
    "\n",
    "Ex7_merge = pd.merge(left=Ex7_0_shots,right=Ex7_1_shots,left_on=['text','true_emotion'],right_on=['text','true_emotion'],suffixes=('_0', '_1'))\n",
    "Ex7_merge = pd.merge(left=Ex7_merge,right=Ex7_5_shots,left_on=['text','true_emotion'],right_on=['text','true_emotion'])\n",
    "Ex7_merge = Ex7_merge.rename(columns={'predicted_emotion':'predicted_emotion_5'})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 68,
   "metadata": {},
   "outputs": [],
   "source": [
    "## Classify the cases\n",
    "def classify_row(df):\n",
    "    # rename for readability\n",
    "    t  = df[\"true_emotion\"]\n",
    "    p0 = df[\"predicted_emotion_0\"]\n",
    "    p1 = df[\"predicted_emotion_1\"]\n",
    "    p5 = df[\"predicted_emotion_5\"]  \n",
    "\n",
    "    # Case 1: improved with examples (baseline wrong → final right)\n",
    "    if (p0 != t) and (p5 == t):\n",
    "        return \"Improve\"\n",
    "\n",
    "    # Case 2: got worse (was correct at some earlier stage → final wrong)\n",
    "    if ((p0 == t) or (p1 == t)) and (p5 != t):\n",
    "        return \"Broke\"\n",
    "\n",
    "    # Case 3: does not improve (all predictions wrong)\n",
    "    if ((p0 != t) and (p1 != t) and (p5 != t)):\n",
    "        return \"Does not improve\"\n",
    "\n",
    "    # Case 4: all correct\n",
    "    if ((p0 == t) and (p1 == t) and (p5 == t)):\n",
    "        return \"All Correct\"\n",
    "\n",
    "# Apply to each row to create a new column\n",
    "Ex7_merge[\"case\"] = Ex7_merge.apply(classify_row, axis=1)"
   ]
  },
